{
  "name": "pr-tracker",
  "version": "0.0.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ],
    "*.{ts,tsx,html,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --coverage",
    "lint": "ng lint",
    "prepare": "husky",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@tailwindcss/postcss": "^4.3.3",
    "dexie": "^4.4.6",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/angular": "^17.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^30.0.0",
    "angular-eslint": "22.2.0",
    "eslint": "^10.9.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "packageManager": "pnpm@11.25.0"
}
